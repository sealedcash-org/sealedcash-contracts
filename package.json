{
  "name": "@sealedcash/contracts",
  "version": "0.1.0",
  "description": "Auditable SealedCash Solidity pool and escrow contracts.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/sealedcash-org/sealedcash-contracts#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/sealedcash-org/sealedcash-contracts.git"
  },
  "bugs": {
    "url": "https://github.com/sealedcash-org/sealedcash-contracts/issues"
  },
  "exports": {
    "./SealedCashEscrow.json": "./artifacts/contracts/SealedCashEscrow.sol/SealedCashEscrow.json",
    "./SealedCashPrivacyPool.json": "./artifacts/contracts/SealedCashPrivacyPool.sol/SealedCashPrivacyPool.json",
    "./SealedCashUltraHonkAdapter.json": "./artifacts/contracts/SealedCashUltraHonkAdapter.sol/SealedCashUltraHonkAdapter.json"
  },
  "scripts": {
    "build": "hardhat compile",
    "build:production": "hardhat compile --build-profile production",
    "test": "hardhat compile && node --experimental-strip-types --test --test-reporter=spec test/*.ts",
    "test:escrow": "hardhat compile && node --experimental-strip-types --test --test-reporter=spec test/SealedCashEscrow.ts",
    "test:pool": "hardhat compile && node --experimental-strip-types --test --test-reporter=spec test/SealedCashPrivacyPool.ts",
    "preflight": "node scripts/preflight-sealedcash.mjs",
    "deploy": "node scripts/deploy-sealedcash.mjs",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "3.0.0",
    "@nomicfoundation/hardhat-node-test-runner": "3.0.0",
    "@nomicfoundation/hardhat-viem": "3.0.4",
    "@nomicfoundation/hardhat-viem-assertions": "3.0.5",
    "@openzeppelin/contracts": "5.7.0",
    "@types/node": "25.9.3",
    "hardhat": "3.16.0",
    "poseidon2-evm": "2.0.0",
    "viem": "2.56.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}